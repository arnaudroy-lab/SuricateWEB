{
  "name": "suricateweb",
  "version": "1.38.8",
  "description": "SuricateWeb — surveillance de sites web (défiguration, piratage, remplacement, transfert) avec alertes Telegram. Node.js pur, zéro dépendance.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnaudroy-lab/SuricateWEB.git"
  },
  "homepage": "https://github.com/arnaudroy-lab/SuricateWEB#readme",
  "docs": {
    "url": "https://docs.suricateweb.fr",
    "languages": ["fr", "en"]
  },
  "bugs": {
    "url": "https://github.com/arnaudroy-lab/SuricateWEB/issues"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "demo": "node --disable-warning=ExperimentalWarning scripts/docs/demo.js",
    "docs:screenshots": "node --disable-warning=ExperimentalWarning scripts/docs/make-screenshots.js"
  },
  "engines": {
    "node": ">=22.13"
  }
}
